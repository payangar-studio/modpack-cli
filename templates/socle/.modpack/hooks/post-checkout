#!/bin/sh
# Managed by modpack-cli; `modpack update` rewrites this file.
# After a branch change: downloads the missing jars and reloads the variant loaded
# in the pack's instance. The third argument is 1 for a branch change, 0 for a
# checkout of files, which is left alone.

[ "$3" = 1 ] || exit 0

if ! command -v modpack >/dev/null 2>&1; then
    echo "modpack-cli: modpack is not in PATH, the instance was not updated; install modpack-cli, then run \`modpack install\`." >&2
    exit 0
fi

modpack install </dev/null ||
    echo "modpack-cli: the instance was left as it is; fix the problem above, then run \`modpack install\`." >&2
exit 0
